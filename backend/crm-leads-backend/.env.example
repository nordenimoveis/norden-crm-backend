NODE_ENV=development
PORT=3333

# Provisionados pelo Railway/Render (ou local via Docker)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/crm_leads"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="troque-por-um-segredo-forte-e-unico"

# Imobzi (Fase 5): webhook de novos leads do site + importação da base antiga
# IMOBZI_WEBHOOK_TOKEN: mesmo valor cadastrado no campo "authorization" do
# webhook no painel do Imobzi (Administrador > Integrações > Webhooks)
IMOBZI_WEBHOOK_TOKEN="gere-um-token-aleatorio-e-configure-no-imobzi"
# IMOBZI_API_TOKEN: sua Secret Key do Imobzi (Administrador > Integrações e
# Automações > API Keys) — enviada no header X-Imobzi-Secret
IMOBZI_API_BASE_URL="https://api.imobzi.app/v1"
IMOBZI_API_TOKEN=

# Preenchidos no Módulo 3 (Meta Ads) e Módulo 4 (WhatsApp)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Omnichannel (Instagram Direct + Messenger + comentários de posts).
# Usa o MESMO META_PAGE_ACCESS_TOKEN acima. Configure o webhook do App da Meta
# apontando para /webhooks/meta-messaging e assine os campos: messages,
# messaging_postbacks (Messenger), instagram (messages) e comments/feed.
#  - META_PAGE_ID: id da Página do Facebook (Messenger + comentários no FB).
#  - META_IG_ACCOUNT_ID: id da conta comercial do Instagram (DM + comentários IG).
META_PAGE_ID=
META_IG_ACCOUNT_ID=

# Trava anti-ban (Fase 4): teto diário de mensagens automatizadas. Comece baixo
# e aumente aos poucos conforme o número ganha reputação no WhatsApp.
MAX_DAILY_MESSAGES=100

# Pusher (Fase 5) — tempo real do painel Kanban + chat.
# Pegue esses valores em https://dashboard.pusher.com (app > App Keys)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# URL do front-end (Vercel) — restringe o CORS em produção. Em desenvolvimento
# pode deixar vazio (CORS aceita qualquer origem nesse caso).
FRONTEND_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta WhatsApp Business (WABA) — necessário para sincronizar os
# templates aprovados direto da Meta na tela de Campanhas.
WHATSAPP_WABA_ID=
