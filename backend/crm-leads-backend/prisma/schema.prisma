generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  gestor
  corretor
  admin
}

enum LeadStatus {
  novo // Novo Lead
  respondeu // Aguardando Resposta (transbordo humano da Fase 4)
  em_atendimento // Em Atendimento (corretor assumiu a conversa manualmente)
  visita_agendada // Visita Agendada
  proposta // Proposta
  negocio_fechado // Negócio Fechado
  perdido
  frio_standby // Passo 4 da cadência concluído sem resposta
}

enum LeadOrigem {
  meta_ads
  site_imobzi // lead do formulário do site, que hoje cai primeiro no Imobzi (gateway)
  legado_imobzi // importado da base antiga do Imobzi — nunca entra em roleta/cadência
  importacao_planilha // importado por planilha (Excel/CSV) — nunca entra em roleta/cadência automaticamente
  manual // cadastrado direto pela equipe (telefone, indicação, presencial) — nunca dispara cadência sozinho
  instagram // conversa iniciada por Instagram Direct — atendimento humano, sem cadência WhatsApp
  messenger // conversa iniciada por Messenger — atendimento humano, sem cadência WhatsApp
}

enum LeadTemperatura {
  nao_avaliado // padrão para lead novo — o corretor só sabe a temperatura após o 1º contato
  frio
  morno
  quente
}

enum TipoAgendamento {
  visita
  reuniao
  ligacao
  whatsapp
  outro
}

enum ExecucaoStatus {
  ativa
  pausada
  concluida
  cancelada
}

enum MensagemDirecao {
  enviada
  recebida
}

enum MensagemStatus {
  pendente
  enviada
  entregue
  lida
  falhou
}

// Canal de origem/destino de uma conversa. O CRM começou 100% WhatsApp; a
// partir da fase omnichannel (estilo Respond.io) a mesma caixa de entrada
// atende também Instagram Direct e Messenger. Comentários de posts são
// tratados à parte (model ComentarioSocial), pois são públicos e em thread.
enum Canal {
  whatsapp
  instagram
  messenger
}

// Direção de um comentário de post: recebido (o público comentou) ou
// enviado (a imobiliária respondeu pelo painel).
enum ComentarioDirecao {
  recebido
  enviado
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  papel        UserRole @default(corretor)
  ativo        Boolean  @default(true)
  ordemRoleta  Int      @default(0) @map("ordem_roleta") // posição na fila do round-robin de distribuição de leads
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  leads                   Lead[]            @relation("CorretorLeads")
  mensagensEnviadas       Mensagem[]        @relation("MensagemEnviadaPor")
  quickReplies            QuickReply[]      @relation("QuickReplyDoUsuario")
  campanhasDisparoCriadas CampanhaDisparo[] @relation("CampanhaDisparoCriadaPor")
  notasEscritas           NotaInterna[]

  @@map("usuarios")
}

model Imovel {
  imobziId          String?                      @unique @map("imobzi_id")
  id                String                       @id @default(uuid())
  titulo            String
  bairro            String?
  cidade            String                       @default("Florianópolis")
  valor             Decimal?                     @db.Decimal(14, 2)
  metragem          Int? // m² — usado no embedding e exibido no card de match
  quartos           Int?
  descricao         String? // texto semântico livre — vira o embedding de match
  fotoUrl           String?                      @map("foto_url")
  referenciaExterna String?                      @map("referencia_externa")
  ativo             Boolean                      @default(true)
  criadoEm          DateTime                     @default(now()) @map("criado_em")
  embedding         Unsupported("vector(1024)")?

  leads         Lead[]
  visualizacoes ImovelVisualizacao[]

  @@map("imoveis")
}

// Registra quando um LEAD visualiza um imóvel específico (via link
// rastreado) — soma score e também vira histórico de interesse, útil pra
// refinar o "motivo do match" no futuro (ex: "já visitou esse anúncio 2x").
model ImovelVisualizacao {
  id       String   @id @default(uuid())
  leadId   String   @map("lead_id")
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  imovelId String   @map("imovel_id")
  imovel   Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([leadId])
  @@index([imovelId])
  @@map("imovel_visualizacoes")
}

model Campanha {
  id             String   @id @default(uuid())
  nome           String
  metaCampaignId String?  @map("meta_campaign_id")
  metaFormId     String?  @map("meta_form_id")
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")

  leads Lead[]

  @@map("campanhas")
}

enum CampanhaDisparoStatus {
  rascunho // em edição, ainda não confirmada
  pronta // pronta para envio, aguardando o motor de disparo (Peça 4)
  agendada // agendada para disparar em uma data/hora futura
  enviando // motor de disparo em progresso
  concluida
  cancelada
}

// Campanha de disparo em massa via WhatsApp (não confundir com `Campanha`,
// que rastreia a origem de leads do Meta Ads — nomes parecidos, conceitos
// diferentes). O público é "congelado" na criação via `CampanhaDisparoLead`
// — não recalcula sozinho se novos leads passarem a bater com o filtro
// depois, o que torna o envio previsível e auditável.
//
// `templateMensagemId` é obrigatório e deve apontar para um template
// aprovado pela Meta — texto livre não é permitido aqui de propósito: é a
// trava que impede o uso dessa ferramenta para disparo não solicitado.
model CampanhaDisparo {
  id                 String                @id @default(uuid())
  nome               String
  templateMensagemId String                @map("template_mensagem_id")
  templateMensagem   TemplateMensagem      @relation(fields: [templateMensagemId], references: [id])
  status             CampanhaDisparoStatus @default(rascunho)
  // URL real (Cloudinary) da mídia anexada — só relevante se o template
  // escolhido tiver templateMensagem.midiaTipo definido.
  midiaUrl           String?               @map("midia_url")

  // Valores das variáveis {{1}}, {{2}}... preenchidos no compositor. Guardado
  // como JSON (array de strings na ordem) para reconstruir o preview e para
  // o worker montar os parâmetros no envio.
  parametros Json?

  // Quando o disparo deve começar (status 'agendada'). Null = envio imediato.
  agendadoPara     DateTime? @map("agendado_para")
  // Id do job atrasado no BullMQ que dispara o início — usado para cancelar
  // um agendamento antes da hora.
  jobAgendamentoId String?   @map("job_agendamento_id")

  criadoPorUsuarioId String  @map("criado_por_usuario_id")
  criadoPor          Usuario @relation("CampanhaDisparoCriadaPor", fields: [criadoPorUsuarioId], references: [id])

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  destinatarios CampanhaDisparoLead[]

  @@map("campanhas_disparo")
}

model CampanhaDisparoLead {
  id                String          @id @default(uuid())
  campanhaDisparoId String          @map("campanha_disparo_id")
  campanhaDisparo   CampanhaDisparo @relation(fields: [campanhaDisparoId], references: [id], onDelete: Cascade)
  leadId            String          @map("lead_id")
  // Cascade: excluir um lead remove também seus registros de destinatário de
  // campanha (sem isso, não seria possível excluir um lead que já foi alvo de
  // uma campanha, que é o caso comum).
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status    String    @default("pendente") // pendente | enviado | falhou
  erro      String? // motivo da falha, quando status = falhou — útil pra diagnosticar sem vasculhar logs
  enviadoEm DateTime? @map("enviado_em")

  @@unique([campanhaDisparoId, leadId])
  @@map("campanha_disparo_leads")
}

model Lead {
  id             String  @id @default(uuid())
  nome           String?
  // Opcional desde a fase omnichannel: um lead que chega por Instagram Direct
  // ou Messenger pode não ter telefone. A identidade de cada canal (telefone,
  // PSID, IGSID) fica em ContatoCanal; `telefone` continua aqui por ser a
  // chave natural do fluxo WhatsApp (cadência, disparo, dedupe de anúncio).
  telefone       String?
  email          String?
  // Canal por onde o lead entrou / é atendido preferencialmente. Define qual
  // conexão a caixa de entrada usa por padrão ao responder.
  canalPrincipal Canal   @default(whatsapp) @map("canal_principal")

  campanhaId String?   @map("campanha_id")
  campanha   Campanha? @relation(fields: [campanhaId], references: [id])

  imovelId String? @map("imovel_id")
  imovel   Imovel? @relation(fields: [imovelId], references: [id])

  corretorId String?  @map("corretor_id")
  corretor   Usuario? @relation("CorretorLeads", fields: [corretorId], references: [id])

  status               LeadStatus       @default(novo)
  origem               LeadOrigem       @default(meta_ads)
  temperatura          LeadTemperatura  @default(nao_avaliado)
  imobziId             String?          @unique @map("imobzi_id") // evita duplicidade ao receber o mesmo lead do Imobzi mais de uma vez
  atendimentoHumano    Boolean          @default(false) @map("atendimento_humano")
  // Conversa arquivada: sai da caixa de entrada e da lista de leads por padrão,
  // sem apagar nada. Usado para "limpar" o inbox de conversas encerradas.
  arquivada            Boolean          @default(false) @map("arquivada")
  payloadBruto         Json?            @map("payload_bruto")
  dataAgendamento      DateTime?        @map("data_agendamento") // quando é o compromisso — independente do status do Kanban
  tipoAgendamento      TipoAgendamento? @map("tipo_agendamento")
  // Quando QUALQUER pessoa da equipe abriu essa conversa pela última vez —
  // é um "visto" de inbox compartilhado (não por usuário individual), do
  // jeito que times de suporte costumam tratar isso: o que importa é se
  // ALGUÉM da equipe já viu, não se cada corretor individualmente viu.
  ultimaVisualizacaoEm DateTime?        @map("ultima_visualizacao_em")

  // IA / RAG — a IA nunca manda mensagem sozinha: ela gera um RASCUNHO
  // (rascunhoIA) que fica pendente até o corretor revisar e enviar (ou
  // descartar) manualmente pelo chat. `statusIA` controla se isso está
  // ligado pra esse lead específico.
  statusIA   StatusIA @default(inativa) @map("status_ia")
  rascunhoIA String?  @map("rascunho_ia")

  // --- Inteligência Norden ---------------------------------------------
  score           Int     @default(0) // pontuação de engajamento, soma de eventos (ver score.service.ts)
  perfilBusca     Json?   @map("perfil_busca") // {bairro, orcamentoMin, orcamentoMax, quartos, finalidade}
  perfilSemantico String? @map("perfil_semantico") // descrição qualitativa livre, usada no embedding de match

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  execucoesCadencia       LeadCadenciaExecucao[]
  mensagens               Mensagem[]
  destinatarioDeCampanhas CampanhaDisparoLead[]
  notas                   NotaInterna[]
  visualizacoesImoveis    ImovelVisualizacao[]
  contatosCanais          ContatoCanal[]
  comentarios             ComentarioSocial[]

  @@unique([telefone, campanhaId])
  @@index([status])
  @@index([corretorId])
  @@index([temperatura])
  @@map("leads")
}

model Cadencia {
  id       String   @id @default(uuid())
  nome     String
  ativo    Boolean  @default(true)
  padrao   Boolean  @default(false) // cadência aplicada automaticamente a todo novo lead
  criadoEm DateTime @default(now()) @map("criado_em")

  passos    CadenciaPasso[]
  execucoes LeadCadenciaExecucao[]

  @@map("cadencias")
}

model CadenciaPasso {
  id                 String            @id @default(uuid())
  cadenciaId         String            @map("cadencia_id")
  cadencia           Cadencia          @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  ordem              Int
  atrasoMinutos      Int               @map("atraso_minutos")
  templateMensagemId String?           @map("template_mensagem_id")
  template           TemplateMensagem? @relation(fields: [templateMensagemId], references: [id])
  condicao           String            @default("sem_resposta")

  @@unique([cadenciaId, ordem])
  @@map("cadencia_passos")
}

model LeadCadenciaExecucao {
  id               String         @id @default(uuid())
  leadId           String         @map("lead_id")
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cadenciaId       String         @map("cadencia_id")
  cadencia         Cadencia       @relation(fields: [cadenciaId], references: [id])
  passoAtual       Int            @default(0) @map("passo_atual")
  status           ExecucaoStatus @default(ativa)
  proximoDisparoEm DateTime?      @map("proximo_disparo_em")
  proximoJobId     String?        @map("proximo_job_id") // ID do job no BullMQ/Redis — usado para cancelar o disparo agendado se o lead responder antes
  iniciadaEm       DateTime       @default(now()) @map("iniciada_em")
  atualizadaEm     DateTime       @updatedAt @map("atualizada_em")

  @@index([proximoDisparoEm])
  @@map("lead_cadencia_execucao")
}

enum TipoMidiaTemplate {
  image
  video
  document
}

model TemplateMensagem {
  id               String             @id @default(uuid())
  nome             String
  conteudo         String
  metaTemplateName String?            @map("meta_template_name")
  aprovadoMeta     Boolean            @default(false) @map("aprovado_meta")
  // Descreve a ESTRUTURA do template aprovado na Meta: esse template tem um
  // cabeçalho de mídia (imagem/vídeo/documento)? null = template só-texto.
  // Isso é fixo por template — precisa bater com o que foi aprovado lá.
  midiaTipo        TipoMidiaTemplate? @map("midia_tipo")

  // --- Metadados do template na Meta (preenchidos pela sincronização) -----
  // Idioma aprovado (ex.: pt_BR) — usado no envio.
  idioma       String  @default("pt_BR")
  // Quantas variáveis o corpo tem — o compositor gera um campo por variável.
  numVariaveis Int     @default(0) @map("num_variaveis")
  // Identificadores das variáveis, na ordem de aparição. Posicionais viram
  // ["1","2",...]; NOMEADAS (padrão novo da Meta) viram os nomes
  // (["nome_cliente","bairro_imovel"]). Decide o formato do envio.
  variaveis    Json?
  // Categoria da Meta (MARKETING / UTILITY / AUTHENTICATION), quando conhecida.
  categoria    String?
  // Status bruto vindo da Meta (APPROVED / PENDING / REJECTED). aprovadoMeta
  // é derivado disto, mas guardamos o cru para exibir no painel.
  metaStatus   String? @map("meta_status")
  // Texto do rodapé aprovado (opcional) — só para exibir no preview.
  rodape       String?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  passos           CadenciaPasso[]
  mensagens        Mensagem[]
  campanhasDisparo CampanhaDisparo[]

  @@map("templates_mensagem")
}

enum QuickReplyTipo {
  global // criado pelo Admin/Gestor, visível para toda a equipe
  pessoal // criado por um corretor, visível só para ele
}

model QuickReply {
  id            String         @id @default(uuid())
  titulo        String // usado na busca rápida do popover (Next.js)
  textoMensagem String         @map("texto_mensagem") // suporta variáveis: {{lead_name}}, {{broker_name}}
  tipo          QuickReplyTipo

  // Dono do template — obrigatório quando tipo = 'pessoal', null quando 'global'.
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation("QuickReplyDoUsuario", fields: [usuarioId], references: [id])

  ativo               Boolean  @default(true)
  // Marca ESTE quick reply como o modelo usado na sugestão automática de
  // pedido de avaliação Google, quando um negócio é fechado no Kanban.
  paraAvaliacaoGoogle Boolean  @default(false) @map("para_avaliacao_google")
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  @@index([tipo])
  @@index([usuarioId])
  @@map("quick_replies")
}

// Histórico de notas internas — cada nota é um registro imutável (autor +
// data), não um campo único que se sobrescreve. É o que dá a "timeline de
// evolução do lead" que a equipe consegue rolar pra trás e entender o
// histórico de observações, sem perder o que já foi escrito antes.
model NotaInterna {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  texto     String
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([leadId, criadoEm])
  @@map("notas_internas")
}

// --- IA / RAG ---------------------------------------------------------
// Base de conhecimento pro atendimento com IA: documentos (PDFs/URLs)
// quebrados em pedaços (chunks) com embedding vetorial, buscados por
// similaridade semântica (pgvector) na hora de gerar uma resposta.

enum OrigemDocumento {
  pdf
  url
}

model Documento {
  id        String          @id @default(uuid())
  titulo    String
  origem    OrigemDocumento
  urlOrigem String?         @map("url_origem") // caminho do PDF ou a URL, conforme `origem`
  criadoEm  DateTime        @default(now()) @map("criado_em")

  chunks DocumentoChunk[]

  @@map("documentos")
}

model DocumentoChunk {
  id          String                       @id @default(uuid())
  documentoId String                       @map("documento_id")
  documento   Documento                    @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  conteudo    String
  // Vetor de embedding (Voyage AI, modelo voyage-3 = 1024 dimensões).
  // Prisma não tem tipo nativo pra `vector` — fica marcado como
  // Unsupported, e todo acesso (insert/busca) passa por SQL puro
  // ($queryRaw/$executeRaw) no service, não pelo Prisma Client normal.
  embedding   Unsupported("vector(1024)")?
  criadoEm    DateTime                     @default(now()) @map("criado_em")

  @@map("documento_chunks")
}

enum StatusIA {
  inativa // padrão — atendimento sempre humano, IA nunca entra
  ativa // IA gera sugestão de resposta a cada mensagem do lead
  pausada_humano // foi desligada manualmente pro corretor assumir sem sugestão
}

// --- fim IA / RAG -------------------------------------------------------

model Mensagem {
  id                String            @id @default(uuid())
  leadId            String            @map("lead_id")
  lead              Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direcao           MensagemDirecao
  conteudo          String
  // Canal em que a mensagem trafegou. Default whatsapp preserva o
  // comportamento das mensagens já existentes na base.
  canal             Canal             @default(whatsapp)
  // Tipo da mídia quando `midiaUrl` está presente (image/video/audio/document/sticker).
  tipoMidia         String?           @map("tipo_midia")
  midiaUrl          String?           @map("midia_url")
  templateId        String?           @map("template_id")
  template          TemplateMensagem? @relation(fields: [templateId], references: [id])
  status            MensagemStatus    @default(pendente)
  // Motivo da falha quando status = falhou (código + título do erro da Meta,
  // ex.: "131049 - Message not delivered to maintain healthy engagement").
  // Preenchido pelo webhook de status do WhatsApp para o corretor ver o porquê.
  erro              String?           @map("erro")
  // ID da mensagem no WhatsApp Cloud API (mantido para não quebrar dados
  // históricos e o webhook de status de entrega/leitura do WhatsApp).
  whatsappMessageId String?           @map("whatsapp_message_id")
  // ID da mensagem no provedor, canal-agnóstico (mid do Messenger/Instagram,
  // ou o mesmo wamid do WhatsApp). Usado para casar recibos e evitar eco.
  externalId        String?           @map("external_id")

  // Contato de canal específico que originou/recebeu a mensagem. Opcional
  // para não exigir backfill das mensagens WhatsApp antigas.
  contatoCanalId String?       @map("contato_canal_id")
  contatoCanal   ContatoCanal? @relation(fields: [contatoCanalId], references: [id])

  // null = mensagem automática (cadência); preenchido = corretor que respondeu manualmente pelo chat.
  // Importante no modelo de "Número Único": several corretores usam a mesma conexão de WhatsApp,
  // então isso é o que permite saber quem disse o quê.
  enviadaPorUsuarioId String?  @map("enviada_por_usuario_id")
  enviadaPorUsuario   Usuario? @relation("MensagemEnviadaPor", fields: [enviadaPorUsuarioId], references: [id])

  enviadaEm DateTime? @map("enviada_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([leadId, criadoEm])
  @@index([externalId])
  @@map("mensagens")
}

// Identidade de um lead em UM canal específico (o "endereço" por onde falamos
// com ele). Um mesmo lead/pessoa pode ter várias: telefone no WhatsApp, PSID
// no Messenger, IGSID no Instagram. É isso que permite a caixa de entrada
// unificada saber para onde rotear a resposta em cada canal.
model ContatoCanal {
  id                String    @id @default(uuid())
  leadId            String    @map("lead_id")
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  canal             Canal
  // Telefone (WhatsApp), PSID (Messenger) ou IGSID (Instagram). É o `id` que
  // a Graph API espera no campo `recipient` ao enviar uma mensagem.
  identidadeExterna String    @map("identidade_externa")
  nomeExibicao      String?   @map("nome_exibicao")
  username          String? // @ do Instagram, quando disponível
  fotoUrl           String?   @map("foto_url")
  // Momento da última mensagem RECEBIDA neste canal — base da janela de 24h
  // de atendimento (WhatsApp/Instagram/Messenger só permitem mensagem livre
  // dentro de 24h após o último contato do cliente).
  ultimaRecebidaEm  DateTime? @map("ultima_recebida_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  mensagens Mensagem[]

  @@unique([canal, identidadeExterna])
  @@index([leadId])
  @@map("contatos_canais")
}

// Comentário em um post do Instagram/Facebook. Diferente de uma DM: é público,
// vive numa thread (pode ter respostas), e responder cria um novo comentário
// filho. A caixa de entrada mostra estes numa aba própria de "Comentários".
model ComentarioSocial {
  id                  String            @id @default(uuid())
  canal               Canal // instagram ou messenger (Facebook Page)
  // IDs vindos da Graph API — comentarioExternoId é único por plataforma.
  comentarioExternoId String            @unique @map("comentario_externo_id")
  postId              String            @map("post_id")
  parentId            String?           @map("parent_id") // comentário-pai quando é uma resposta
  permalink           String?
  direcao             ComentarioDirecao @default(recebido)

  // Autor do comentário (público). Guardamos o id/username para poder puxar
  // a conversa para a DM e para casar com um Lead existente do mesmo canal.
  autorExternoId String? @map("autor_externo_id")
  autorNome      String? @map("autor_nome")
  autorUsername  String? @map("autor_username")

  texto      String
  respondido Boolean @default(false)
  ocultado   Boolean @default(false) // comentário escondido/moderado via API

  // Lead correspondente, quando conseguimos casar o autor com um contato de
  // canal já existente (ou quando a equipe vincula manualmente).
  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // Quem respondeu pelo painel (null = ainda não respondido / recebido).
  respondidoPorUsuarioId String? @map("respondido_por_usuario_id")

  criadoEm   DateTime  @default(now()) @map("criado_em")
  recebidoEm DateTime? @map("recebido_em")

  @@index([postId])
  @@index([respondido])
  @@index([parentId])
  @@map("comentarios_sociais")
}
