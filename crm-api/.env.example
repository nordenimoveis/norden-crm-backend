# Usado só para rodar a API fora do Docker (desenvolvimento). Em produção, use infra/.env
NODE_ENV=development
PORT=3333
PUBLIC_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://crm:senha@localhost:5432/crm
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_KEY=
CHATWOOT_WEBHOOK_TOKEN=
IMOBZI_WEBHOOK_TOKEN=
CHATWOOT_BASE_URL=https://atendimento.nordenimoveis.com.br
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_ADMIN_TOKEN=
N8N_AI_WEBHOOK_URL=
# Régua: 5 contatos de WhatsApp (1/dia) + 2 tarefas de ligação (dias 2 e 4).
# Nomes dos 5 templates aprovados na Meta (padrões abaixo; só defina se mudar):
# TEMPLATE_STEP_1=norden_boas_vindas
# TEMPLATE_STEP_2=norden_qualificacao
# TEMPLATE_STEP_3=norden_off_market
# TEMPLATE_STEP_4=norden_apoio
# TEMPLATE_STEP_5=norden_despedida
CADENCE_SEND_ENABLED=false
# Campanhas de disparo em massa (false = simula, não envia)
CAMPAIGN_SEND_ENABLED=false
CAMPAIGN_BATCH_SIZE=40
# Leads de formulário do Meta (Lead Ads). Vazio = desligado.
# Segredo único usado como verify token (GET) e como ?token= (POST) do webhook /webhooks/meta-leadgen.
META_LEADGEN_TOKEN=
# Token da Graph API (com leads_retrieval + acesso à página) para buscar os dados do lead.
META_GRAPH_TOKEN=
META_GRAPH_VERSION=v21.0
