# =====================================================================
# Norden CRM — variáveis da VPS. Copie para ".env" e preencha.
# Gere os segredos com: ./gerar-segredos.sh
# =====================================================================

# --- Domínios (crie registros A na KingHost apontando para o IP da VPS)
CRM_DOMAIN=api-crm.nordenimoveis.com.br
CRM_PANEL_DOMAIN=crm.nordenimoveis.com.br
CHATWOOT_DOMAIN=atendimento.nordenimoveis.com.br
N8N_DOMAIN=automacao.nordenimoveis.com.br
ACME_EMAIL=seu-email@nordenimoveis.com.br
# O painel fala com a API pela rede interna do Docker, então o CORS da API
# não é necessário para ele. Mantido só caso algum cliente HTTP externo
# (ex.: testes) precise chamar a API pelo navegador; deixe vazio se não usar.
CRM_CORS_ORIGINS=https://crm.nordenimoveis.com.br

# --- Banco de dados
POSTGRES_ROOT_PASSWORD=
CHATWOOT_DB_PASSWORD=
N8N_DB_PASSWORD=
CRM_DB_PASSWORD=
REDIS_PASSWORD=

# --- Chatwoot
CHATWOOT_VERSION=v4.14.0
CHATWOOT_SECRET_KEY_BASE=
# E-mail transacional (pode usar o Resend via SMTP: smtp.resend.com, porta 587, usuário "resend")
MAILER_SENDER_EMAIL=Norden Atendimento <atendimento@send.nordenimoveis.com.br>
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

# --- n8n
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- CRM API
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_KEY=
CHATWOOT_WEBHOOK_TOKEN=
IMOBZI_WEBHOOK_TOKEN=
# Preencher depois de configurar o Chatwoot (passo 5 do README)
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
CHATWOOT_ADMIN_TOKEN=
# Preencher depois de importar o workflow de IA no n8n (vazio = IA desligada)
N8N_AI_WEBHOOK_URL=
# Deixe false até os 4 templates estarem aprovados na Meta
CADENCE_SEND_ENABLED=false
# Campanhas de disparo em massa: deixe false até ter templates aprovados
CAMPAIGN_SEND_ENABLED=false
CAMPAIGN_BATCH_SIZE=40

# --- Leads de formulário do Meta (Lead Ads) — opcional
# Segredo único: use o mesmo valor como "Token de verificação" e no ?token= da URL de callback.
# Gere com: openssl rand -hex 24 (ou deixe vazio para desligar)
META_LEADGEN_TOKEN=
# Token da Graph API com permissão leads_retrieval + acesso à página (para buscar os dados do lead)
META_GRAPH_TOKEN=
META_GRAPH_VERSION=v21.0
